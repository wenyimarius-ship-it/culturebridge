# 复制为 .env 并填写。.env 已在 .gitignore 中，不会被提交。
# 部署到 Streamlit Cloud 时，把同样的键写进 App settings → Secrets（TOML 格式，值要加引号）。

# 必填：DeepSeek（或兼容 OpenAI 接口的）API Key
DEEPSEEK_API_KEY=

# 选填：管理员口令。设置后，才能在页面里查看原始反馈并下载 CSV
ADMIN_KEY=

# 选填：Supabase 持久存储。两项都填才会启用，否则写本地 CSV（云端重启后会清空）
# SUPABASE_KEY 必须是服务端密钥（secret key / service_role），不是 publishable / anon key
SUPABASE_URL=
SUPABASE_KEY=

# 选填：应用的公开网址，用来拼接“受众测试链接”
APP_URL=https://your-app-name.streamlit.app

# 选填：额度保护（默认：每次访问 15 次，全站每天 200 次）
SESSION_LIMIT=15
DAILY_LIMIT=200

# 选填：更换模型
# CULTUREBRIDGE_MODEL=deepseek-chat
